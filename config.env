CONFIG_ENV=config.env

# ============================================================ Kernel source ==
KERNEL_SOURCE=https://github.com/MiCode/Xiaomi_Kernel_OpenSource
KERNEL_SOURCE_BRANCH=shennong-u-oss
KERNEL_CONFIG=gki_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64

KERNEL_NAME=houji-ksu-next-susfs
ADD_LOCALVERSION_TO_FILENAME=true

EXTRA_CMDS=
CUSTOM_CMDS=

# =================================================================== Clang ==
CLANG_BRANCH=main-kernel
CLANG_VERSION=r596125
USE_CUSTOM_CLANG=false

USE_LLVM=true

# ===================================================================== GCC ==
ENABLE_GCC_ARM64=false
ENABLE_GCC_ARM32=false

# =============================================================== KernelSU ===
KSU_VARIANT=kernelsu-next
KSU_REF=v3.3.0
KSU_HOOK_MODE=manual

KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==
ENABLE_SUSFS=true
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=gki-android14-6.1

# ========================================================== Extra patches ===
ENABLE_PATH_UMOUNT=true
ENABLE_HIDE_STUFF=true
ENABLE_KPM=false

# ================================================================ Kconfig ===
ADD_KPROBES_CONFIG=true
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false
DISABLE_CC_WERROR=true

EXTRA_DEFCONFIG=

# ============================================================= AnyKernel3 ===
USE_CUSTOM_ANYKERNEL3=true
CUSTOM_ANYKERNEL3_SOURCE=https://github.com/osm0sis/AnyKernel3
CUSTOM_ANYKERNEL3_BRANCH=master

# ============================================================== Packaging ===
NEED_DTBO=false
BUILD_BOOT_IMG=false

# ================================================================ Runner ===
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
